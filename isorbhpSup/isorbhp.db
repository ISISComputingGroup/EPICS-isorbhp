    field(SCAN, "5 second")
	field(DTYP, "stream")
	field(INP, "@isorbhp.proto cell1Pressure($(IPADDR),$(P)PRESSURE:CELL1:TS) $(PORT)")
	field(EGU, "bar")
	field(PREC, "5")
}

record(stringin, "$(P)PRESSURE:CELL1:TS") {}

record(ai, "$(P)PRESSURE:CELL2") {
    field(SCAN, "5 second")
	field(DTYP, "stream")
	field(INP, "@isorbhp.proto cell2Pressure($(IPADDR),$(P)PRESSURE:CELL2:TS) $(PORT)")
	field(EGU, "bar")
	field(PREC, "5")
