record(bo, "$(P)SIM")
{
    field(SCAN, "Passive")
    field(DTYP, "Soft Channel")
    field(ZNAM, "NO")
    field(ONAM, "YES")
    field(VAL, "$(RECSIM=0)")
    field(PINI, "YES")
}

record(bo, "$(P)DISABLE")
{
    field(DESC, "Disable comms")
    field(PINI, "YES")
    field(VAL, "$(DISABLE=0)")
    field(OMSL, "supervisory")
    field(ZNAM, "COMMS ENABLED")
    field(ONAM, "COMMS DISABLED")
}

record(bi, "$(P)PAUSED") {
    field(DESC, "Device status")
    field(SCAN, "5 second")
	field(DTYP, "stream")
	field(INP, "@isorbhp.proto isPaused($(IPADDR)) $(PORT)")
	field(ZNAM, "Analysis Running")
	field(ONAM, "Analysis Paused")
	info(archive, "VAL")
	info(interest, "HIGH")
	field(SDIS, "$(P)DISABLE")
}

record(bo, "$(P)PAUSED:SP") {
    field(DESC, "Device status setpoint")
    field(DTYP, "stream")
	field(OUT, "@isorbhp.proto setPaused($(IPADDR)) $(PORT)")
	field(ZNAM, "Analysis Running")
	field(ONAM, "Analysis Paused")
	info(archive, "VAL")
	field(SDIS, "$(P)DISABLE")
}

record(stringin, "$(P)EQ_STARTED") {
    field(DESC, "Equilibration started timestamp")
    field(SCAN, "5 second")
	field(DTYP, "stream")
	field(INP, "@isorbhp.proto eqStarted($(IPADDR)) $(PORT)")
	info(archive, "VAL")
	info(interest, "HIGH")
	field(SDIS, "$(P)DISABLE")
}

record(ai, "$(P)PRESSURE:MANIFOLD") {
    field(DESC, "Manifold Pressure")
    field(SCAN, "5 second")
	field(DTYP, "stream")
	field(INP, "@isorbhp.proto manifoldPressure($(IPADDR),$(P)PRESSURE:MANIFOLD:TS) $(PORT)")
	field(EGU, "bar")
	field(PREC, "5")
	field(LOLO, "0")
	field(LLSV, "INVALID")
	info(archive, "VAL")
	info(interest, "HIGH")
	field(SDIS, "$(P)DISABLE")
}

record(stringin, "$(P)PRESSURE:MANIFOLD:TS") {
    field(DESC, "Manifold Pressure timestamp")
	info(archive, "VAL")
}

